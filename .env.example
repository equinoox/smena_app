# Copy this file to .env and fill in your Supabase project values.
# Find them in the Supabase dashboard: Project Settings -> API.
# EXPO_PUBLIC_* vars are inlined into the app bundle at build time.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Mapbox public access token (starts with pk.) — used for map tiles and the
# Geocoding API. Get one from https://account.mapbox.com/access-tokens/.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=your-mapbox-public-token

# NOT an EXPO_PUBLIC_* var — this is a direct Postgres connection string with full
# database access. Never prefix it EXPO_PUBLIC_ (it would ship inside the app bundle)
# and never commit a real value. Used only by `npm run db:reset`/`db:seed` (local dev
# tooling, via scripts/run-sql.js + psql) — get it from the Supabase dashboard:
# Project Settings -> Database -> Connection string (URI).
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
